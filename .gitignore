# Dependencies
node_modules/

# Build output: a compiled GitHub Action ships a bundled dist/, so dist/ IS
# committed (a runner executes dist/index.js directly). CI's check-dist step
# keeps it in sync with src/. The intermediate tsc dir is not committed.
dist-tsc/

# Env / secrets — never commit
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.log
.idea/
.vscode/

# Test / coverage
coverage/
